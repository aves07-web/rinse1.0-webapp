{
  "appId": "com.rinse.laundryerp",
  "productName": "Rinse",
  "copyright": "Copyright © 2026 Rinse",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json",
    "!dist/**/*.map",
    "!node_modules/vite/**/*",
    "!node_modules/@rolldown/**/*",
    "!node_modules/@tailwindcss/**/*",
    "!node_modules/tailwindcss/**/*",
    "!node_modules/@vitejs/**/*",
    "!node_modules/esbuild/**/*",
    "!node_modules/@esbuild/**/*",
    "!node_modules/typescript/**/*",
    "!node_modules/tsx/**/*",
    "!node_modules/echarts/**/*",
    "!node_modules/jspdf/**/*",
    "!node_modules/html2canvas/**/*",
    "!node_modules/lucide-react/**/*",
    "!node_modules/motion/**/*",
    "!node_modules/react/**/*",
    "!node_modules/react-dom/**/*",
    "!node_modules/qrcode/**/*",
    "!node_modules/@google/**/*"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64", "ia32"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Rinse",
    "artifactName": "Rinse-Setup-${version}.exe"
  },
  "portable": {
    "artifactName": "Rinse-Portable-${version}-${arch}.exe"
  },
  "linux": {
    "icon": "build/icon.png",
    "target": ["AppImage"]
  }
}
